# AnIm — Agent Intelligence Mesh
#
# Comma-separated gateway base URLs, one per profile, in the same order as
# lib/data/profiles.ts (default, ceo-bor, principal-engineer, social-media,
# management-research, frontend, backend → ports 9900…9906).
#
# When unset, the console falls back to a deterministic simulated mesh so the
# dashboard stays fully interactive offline.
ANIM_GATEWAY_URLS=http://127.0.0.1:9900,http://127.0.0.1:9901,http://127.0.0.1:9902,http://127.0.0.1:9903,http://127.0.0.1:9904,http://127.0.0.1:9905,http://127.0.0.1:9906

# --- Security gate for write-capable endpoints -------------------------------
# /api/agent-chat can start a real Hermes process on the mesh host, so it is
# guarded. Set ANIM_API_TOKEN in any shared or public deployment: operators
# paste it once at /discussion, the server exchanges it for an HttpOnly session
# cookie, and the token never enters browser JavaScript.
# Leave it unset only for local development on a trusted machine.
# ANIM_API_TOKEN=
#
# Per-client chat budget: requests allowed per window, and the window length.
# ANIM_CHAT_RATE_LIMIT=6
# ANIM_CHAT_RATE_WINDOW_MS=60000
# Hard ceiling on simultaneous remote agent processes.
# ANIM_CHAT_MAX_CONCURRENT=2

# --- Live mesh bridge (read-only) --------------------------------------------
# Fixed SSH target used by /api/mesh-live and /api/mesh. Key auth with
# BatchMode; the remote collector never returns secrets.
# ANIM_SSH_HOST=root@72.61.141.91
# ANIM_SSH_TIMEOUT_MS=12000
