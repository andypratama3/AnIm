# AnIm — Agent Intelligence Mesh
#
# Comma-separated gateway base URLs, one per profile, in the same order as
# lib/data/profiles.ts (default, ceo-bor, principal-engineer, social-media,
# management-research, frontend, backend → ports 9900…9906).
#
# When unset, the console falls back to a deterministic simulated mesh so the
# dashboard stays fully interactive offline.
ANIM_GATEWAY_URLS=http://127.0.0.1:9900,http://127.0.0.1:9901,http://127.0.0.1:9902,http://127.0.0.1:9903,http://127.0.0.1:9904,http://127.0.0.1:9905,http://127.0.0.1:9906
