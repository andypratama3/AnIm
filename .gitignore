# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.template

# agent mesh runtime state — never commit live agent data
/agents/.runtime/
*.sock
*.pid
*.db
gateway_state.json
a2a_audit.jsonl
.skills_prompt_snapshot.json
models_dev_cache.json

# credentials / keys — never commit
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials.json
auth.json
secrets/
*_rsa
*_ed25519
.netrc
.npmrc

# local scratch
/tmp/
*.local
*.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.data/
